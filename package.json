{
  "name": "@shelf/esbuild-config",
  "version": "0.3.0",
  "description": "A collection of configurations and utilities to help you build projects or libraries using esbuild. Includes plugins for common tasks like transpiling TypeScript and compiling SASS and styled-components, as well as presets for React.",
  "keywords": [
    "esbuild",
    "build",
    "config",
    "typescript",
    "sass",
    "react",
    "library"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "author": {
    "name": "Andrii Myroniuk",
    "email": "andrii.myroniuk@shelf.io",
    "url": "https://shelf.io"
  },
  "type": "module",
  "exports": {
    ".": {
      "import": "./index.js",
      "require": "./index.js"
    },
    "./frontend": {
      "import": "./frontend.js",
      "require": "./frontend.js"
    },
    "./common": {
      "import": "./common.js",
      "require": "./common.js"
    }
  },
  "main": "./index.js",
  "module": "./index.js",
  "files": [
    "common.js",
    "frontend.js",
    "index.js"
  ],
  "scripts": {
    "lint": "oxfmt && eslint . --fix",
    "lint:ci": "oxfmt --check && eslint ."
  },
  "dependencies": {
    "esbuild": "0.25.0",
    "esbuild-sass-plugin": "3.3.1"
  },
  "devDependencies": {
    "@shelf/eslint-config": "7.1.0",
    "@shelf/prettier-config": "1.1.1",
    "eslint": "10.8.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "lint-staged": "15.2.10",
    "oxfmt": "0.64.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=16"
  },
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{html,md,yml}": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,ts,json}": [
      "oxfmt --no-error-on-unmatched-pattern",
      "eslint --fix"
    ]
  }
}
